# Production environment for admin panel
# Empty backend URL enables relative same-origin routing through reverse proxy (/admin, /auth)
# This ensures session cookies (connect.sid) are first-party on https://admin.factorytribe.com
VITE_MERCUR_BACKEND_URL=https://api.factorytribe.com
VITE_MERCUR_VENDOR_URL=https://vendor.factorytribe.com
