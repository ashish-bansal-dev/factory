# CORS Configuration
# STORE_CORS supports regex enclosed in /.../ for all *.factorytribe.com subdomains and apex
STORE_CORS=/^https?:\/\/([a-zA-Z0-9_-]+\.)*factorytribe\.com(:\d+)?$/,http://localhost:8000,http://localhost:3000
ADMIN_CORS=https://admin.factorytribe.com,http://localhost:7001,http://localhost:9000
VENDOR_CORS=https://vendor.factorytribe.com,http://localhost:7002,http://localhost:9000
AUTH_CORS=/\.factorytribe\.com$/,https://admin.factorytribe.com,https://vendor.factorytribe.com,http://localhost:7001,http://localhost:7002,http://localhost:9000

# Vendor Panel Portal URL
MERCUR_VENDOR_URL=https://vendor.factorytribe.com

