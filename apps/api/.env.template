# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/release
# Optional fallback database name used by scripts
DB_NAME=release

# Redis
REDIS_URL=redis://localhost:6379

# Security Secrets (Must be random, secure keys in production)
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# CORS Configuration (Set to production URLs in production)
# Multiple origins can be comma-separated without trailing slashes
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:7001,http://localhost:9000
VENDOR_CORS=http://localhost:7002
AUTH_CORS=http://localhost:7001,http://localhost:7002,http://localhost:8000,http://localhost:3000,http://localhost:9000

# Vendor Panel Portal URL
MERCUR_VENDOR_URL=http://localhost:7002

# Server Port
PORT=9000

# File Storage Provider: Cloudflare R2 / S3
# If R2 credentials are set, Medusa uses Cloudflare R2 S3-compatible storage.
# If omitted, Medusa falls back to local disk storage.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2 Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public URL for the bucket (Cloudflare R2 pub url or custom domain, e.g. https://pub-xxx.r2.dev or https://assets.yourdomain.com)
R2_FILE_URL=
# Region is 'auto' for Cloudflare R2
R2_REGION=auto
# Optional prefix / folder inside bucket (e.g. uploads/)
R2_PREFIX=
# Optional Cache-Control header (default: "public, max-age=31536000")
R2_CACHE_CONTROL=public, max-age=31536000

# Local File Storage Fallback (used when R2 is not configured)
FILE_BACKEND_URL=http://localhost:9000/static